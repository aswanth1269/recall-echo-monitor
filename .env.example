# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# The Day 3 enrichment step talks to any OpenAI-compatible provider, so you
# can swap provider by changing the three LLM_* vars below. Nothing in the
# code is provider-specific.
#
# --- Recommended free option: Google AI Studio ---------------------------
# Key (no credit card): https://aistudio.google.com/apikey
# IMPORTANT: use a *Flash-Lite* model. As of late 2026 the Flash models are
# capped near 20 requests/day on the free tier, while Flash-Lite is around
# 500/day. Google no longer publishes these numbers - check your own at
# https://aistudio.google.com/rate-limit
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=replace-me

# --- Alternatives (uncomment one, comment the block above) ---------------
# Groq - fastest; free limits moved around in 2026, check the console.
#   Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
#
# Mistral - most generous on tokens; needs phone verification, no card.
#   Key: https://console.mistral.ai/
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
#
# OpenRouter - one key, many models; free tier is only ~50 requests/day.
#   Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# How many times to retry a 429 / 5xx before giving up.
LLM_MAX_ATTEMPTS=6

# --- Anthropic (paid; no free tier) -------------------------------------
# Only needed if you later switch the enrichment step to the anthropic SDK.
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-sonnet-5

# Local paths
DUCKDB_PATH=data/clean/recalls.duckdb
